rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdminOrHigher() {
      return isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ["admin", "superadmin"];
    }

    function isDeleteOperation() {
      return request.resource == null;
    }

    match /{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (!isDeleteOperation() || isAdminOrHigher());
    }
  }
}
