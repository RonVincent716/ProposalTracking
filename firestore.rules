rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasRoleDoc() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserRole() {
      return hasRoleDoc()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : "user";
    }

    function isAdminOrHigher() {
      return currentUserRole() in ["admin", "superadmin"];
    }

    function isSuperadmin() {
      return currentUserRole() == "superadmin";
    }

    function isOwnUserDocument(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId} {
      // Profiles are private, except to the superadmin account-management UI.
      allow read: if isOwnUserDocument(userId) || isAdminOrHigher();

      // A browser may only create its own lowest-privilege account. Privileged
      // accounts are created by Cloud Functions using the Admin SDK.
      allow create: if isOwnUserDocument(userId)
        && request.resource.data.role in ["user", "client"];

      // Users can maintain their profile, but never their role or account status.
      // Superadmins may maintain account metadata, but role changes must go through
      // the Cloud Function below so they are audited and cannot be forged in-browser.
      allow update: if (
          isOwnUserDocument(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "displayName", "name", "photoURL", "phone", "bio", "preferences",
            "email", "emailVerified", "hasPassword", "authProvider", "lastLogin", "updatedAt"
          ])
        ) || (
          isSuperadmin()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["role"])
        );
      allow delete: if isSuperadmin();
    }

    // Explicit collection list: unknown collections are denied by default.
    // Ownership-level rules should be added as proposal records are normalized.
    match /{collection}/{document} {
      allow read, create, update: if isAuthenticated()
        && collection in [
          "activeViewers", "archivedProposals", "assessmentDrafts", "clients",
          "downloadEvents", "emailHistory", "followUpReminders",
          "proposalDiscussionMessages", "proposalDiscussions", "proposalFeedback",
          "proposalNotifications", "proposalPageTracking", "proposals",
          "proposalSessions", "proposalTemplates", "proposalVersions",
          "proposalViewComplete", "proposalViews", "rejectedProposals",
          "sharedProposals", "signedProposals", "userActivities", "proposalAssessments",
          "templateContentBlocks", "pricingCatalog", "proposalApprovalRequests"
        ];
      allow delete: if isAdminOrHigher()
        && collection in [
          "activeViewers", "archivedProposals", "assessmentDrafts", "clients",
          "downloadEvents", "emailHistory", "followUpReminders",
          "proposalDiscussionMessages", "proposalDiscussions", "proposalFeedback",
          "proposalNotifications", "proposalPageTracking", "proposals",
          "proposalSessions", "proposalTemplates", "proposalVersions",
          "proposalViewComplete", "proposalViews", "rejectedProposals",
          "sharedProposals", "signedProposals", "userActivities", "proposalAssessments",
          "templateContentBlocks", "pricingCatalog", "proposalApprovalRequests"
        ];
    }

    match /proposals/{proposalId}/versions/{versionId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isAdminOrHigher();
    }
  }
}
